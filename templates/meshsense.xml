<?xml version="1.0"?>
<Container version="2">
  <Name>MeshSense</Name>
  <Category>HomeAutomation: Network:Management</Category>
  <Repository>ghcr.io/poag/meshsense:latest</Repository>
  <Registry>https://github.com/Poag/meshsense/pkgs/container/meshsense</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Poag/meshsense/issues</Support>
  <Project>https://github.com/Affirmatech/MeshSense</Project>
  <Overview>Headless MeshSense: web UI that monitors and maps your Meshtastic network via a WiFi/TCP node.</Overview>
  <Beta>true</Beta>
  <WebUI>http://[IP]:[PORT:5920]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Poag/docker-xml/refs/heads/master/templates/meshsense.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/Poag/docker-xml/refs/heads/master/images/meshsense.png</Icon>
  <Date>2026-10-04</Date>
  <Changes>### 0.1
- Initial release.</Changes>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/meshsense" Mode="rw" Description="Persistent MeshSense state." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/meshsense</Config>
  <Config Name="WebUI" Target="5920" Default="5920" Mode="tcp" Description="Web UI port." Type="Port" Display="always" Required="true" Mask="false">5920</Config>
  <Config Name="ADDRESS" Target="ADDRESS" Default="" Mode="" Description="IP or hostname of your Meshtastic node (WiFi/TCP)." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="ACCESS_KEY" Target="ACCESS_KEY" Default="" Mode="" Description="Optional API access key (not a web UI login)." Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="PORT" Target="PORT" Default="5920" Mode="" Description="Listen port inside the container; match the WebUI mapping." Type="Variable" Display="advanced" Required="false" Mask="false">5920</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID that runs the app (Unraid default 99)." Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID that runs the app (Unraid default 100)." Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="TZ" Target="TZ" Default="UTC" Mode="" Description="Timezone, e.g. Europe/London." Type="Variable" Display="advanced" Required="false" Mask="false">UTC</Config>
</Container>
